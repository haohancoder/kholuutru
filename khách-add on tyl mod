(async function() {
    // 1. Hiện quảng cáo thương hiệu ngay lập tức
    console.clear();
    console.log("%c TYL MOD BY HẢO HÁN CODER ", "background: #000; color: #f1c40f; font-size: 25px; font-weight: bold; border: 2px solid #f1c40f; padding: 10px; font-family: sans-serif; text-shadow: 2px 2px #e67e22;");
    console.log("%c Chào mừng bạn đến với phiên bản chính thức của Hảo Hán Coder ", "color: #fff; font-style: italic; background: #34495e; padding: 5px;");

    // 2. Kiểm tra mật khẩu TYL MOD
    const password = prompt("[TYL MOD] Nhập mật khẩu kích hoạt:");
    
    if (password !== '123') {
        alert("Sai mật khẩu! Truy cập TYL MOD bị từ chối.");
        return;
    }

    console.log("%c 🚀 Đang kết nối server TYL...", "color: #00ff00; font-weight: bold;");

    try {
        // 3. Link lấy code TYL MOD từ GitHub
        const url = "https://raw.githubusercontent.com/haohancoder/kholuutru/main/add%20on%20website%20game%201";
        const response = await fetch(url);
        
        if (!response.ok) throw new Error("Kết nối server TYL thất bại.");
        const scriptText = await response.text();

        // 4. Khởi chạy lõi TYL MOD
        const runTYL = new Function(scriptText);
        runTYL();

        console.log("%c [OK] TYL MOD ĐÃ SẴN SÀNG! ", "color: #fff; background: #2ecc71; padding: 5px; font-weight: bold;");

    } catch (err) {
        console.error("Lỗi khởi chạy TYL MOD:", err);
        alert("Lỗi hệ thống TYL: " + err.message);
    }
})();
